{
  "name": "@veyra/chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./positionReader": {
      "types": "./dist/src/positionReader.d.ts",
      "default": "./dist/src/positionReader.js"
    },
    "./simulate": {
      "types": "./dist/src/simulate.d.ts",
      "default": "./dist/src/simulate.js"
    },
    "./rebalanceQuote": {
      "types": "./dist/src/rebalanceQuote.d.ts",
      "default": "./dist/src/rebalanceQuote.js"
    },
    "./testnetAddresses": {
      "types": "./dist/src/testnetAddresses.d.ts",
      "default": "./dist/src/testnetAddresses.js"
    },
    "./abis": {
      "types": "./dist/src/abis.d.ts",
      "default": "./dist/src/abis.js"
    },
    "./gridPositionReader": {
      "types": "./dist/src/gridPositionReader.d.ts",
      "default": "./dist/src/gridPositionReader.js"
    },
    "./yieldPositionReader": {
      "types": "./dist/src/yieldPositionReader.d.ts",
      "default": "./dist/src/yieldPositionReader.js"
    },
    "./healthFactorReader": {
      "types": "./dist/src/healthFactorReader.d.ts",
      "default": "./dist/src/healthFactorReader.js"
    },
    "./venusAbis": {
      "types": "./dist/src/venusAbis.d.ts",
      "default": "./dist/src/venusAbis.js"
    },
    "./healthFactorExecutor": {
      "types": "./dist/src/healthFactorExecutor.d.ts",
      "default": "./dist/src/healthFactorExecutor.js"
    },
    "./txSigner": {
      "types": "./dist/src/txSigner.d.ts",
      "default": "./dist/src/txSigner.js"
    },
    "./sessionSigner": {
      "types": "./dist/src/sessionSigner.d.ts",
      "default": "./dist/src/sessionSigner.js"
    },
    "./rebalanceExecutor": {
      "types": "./dist/src/rebalanceExecutor.d.ts",
      "default": "./dist/src/rebalanceExecutor.js"
    },
    "./gridOrchestrator": {
      "types": "./dist/src/gridOrchestrator.d.ts",
      "default": "./dist/src/gridOrchestrator.js"
    },
    "./volatilityReader": {
      "types": "./dist/src/volatilityReader.d.ts",
      "default": "./dist/src/volatilityReader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/positionReader.test.js dist/test/altanaExecutor.test.js dist/test/sessionPause.test.js dist/test/relayHealthCheck.test.js dist/test/volatilityReader.test.js",
    "test:live": "tsc -p tsconfig.json && node --test dist/test/positionReader.live.test.js dist/test/simulate.live.test.js"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.5.1",
    "@veyra/core": "^0.1.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solc": "^0.8.30",
    "typescript": "^5.6.0"
  }
}
